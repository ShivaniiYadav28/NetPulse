{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test": "node --test",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "format": "prettier --ignore-path ../.prettierignore --write \"**/*.{js,json}\"",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"**/*.{js,json}\"",
    "check": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process');function walk(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory()&&e.name!=='node_modules')walk(p);else if(e.isFile()&&p.endsWith('.js'))cp.execFileSync(process.execPath,['--check',p],{stdio:'inherit'});}}walk('.')\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "ext": "js",
    "ignore": [
      "node_modules/**",
      "logs/**",
      "coverage/**"
    ]
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "mongoose": "^9.11.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10"
  }
}
